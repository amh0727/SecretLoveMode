<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   android:background="@color/background_light"
                                                   tools:context=".ui.game.GameActivity">

    <!-- 캐릭터 이름 -->
    <TextView
            android:id="@+id/tvCharacterName"
            style="@style/GameTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="キャラクター名"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- 상태 표시 카드 -->
    <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/status_card_background"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCharacterName">

        <TextView
                android:id="@+id/tvAffinity"
                style="@style/StatusText.Affinity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCharacterName"
                tools:text="好感度: 50 (好意的)"/>

    </LinearLayout>


    <!-- 캐릭터 이미지 -->
    <androidx.cardview.widget.CardView
            android:id="@+id/characterCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@+id/statusCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/conversationCard"
            app:layout_constraintHeight_percent="0.25">  <!-- 이 값을 0.3 또는 0.25 등으로 줄여보세요 -->

        <ImageView
                android:id="@+id/ivCharacter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/kaoru_default"
                android:background="@color/conversation_background"/>
    </androidx.cardview.widget.CardView>

    <!-- 파티클 뷰 추가 -->
    <com.secretlovemode.ParticleView
            android:id="@+id/particleView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@+id/characterCard"
            app:layout_constraintBottom_toBottomOf="@+id/conversationCard"
            app:layout_constraintStart_toStartOf="@+id/characterCard"
            app:layout_constraintEnd_toEndOf="@+id/characterCard" />

    <!-- 대화 카드 -->

    <!-- 선택지 컨테이너 (동적 크기) -->
    <androidx.cardview.widget.CardView
            android:id="@+id/conversationCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toTopOf="@+id/choiceContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/characterCard"
            app:layout_constraintHeight_percent="0.19">

            <ScrollView
                    android:id="@+id/scrollViewConversation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/conversation_background"
                    android:padding="2dp">

    <TextView
            android:id="@+id/tvConversation"
            style="@style/ConversationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/conversation_background"
            android:padding="10dp"
            android:text="会話が始まります...\n\n"/>

</ScrollView>
        </androidx.cardview.widget.CardView>
    <LinearLayout
            android:id="@+id/choiceContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:orientation="vertical"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintHorizontal_bias="0.0">

        <Button
                android:id="@+id/questionButton1"
                style="@style/ChoiceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="選択肢 1"/>

        <Button
                android:id="@+id/questionButton2"
                style="@style/ChoiceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="選択肢 2"/>

        <Button
                android:id="@+id/questionButton3"
                style="@style/ChoiceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="選択肢 3"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfess"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="告白する"
                android:textColor="@color/white"
                app:backgroundTint="@color/confess_button_red"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_heart"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                android:visibility="gone"
                tools:visibility="visible" />
    </LinearLayout>
    <ProgressBar
            android:id="@+id/loadingProgressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible"/>
    <LinearLayout
            android:id="@+id/inputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible" tools:ignore="MissingConstraints"> <!-- 미리보기용 -->
        <Button
                android:id="@+id/btnSubmitInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="送信" tools:layout_editor_absoluteY="439dp" tools:layout_editor_absoluteX="363dp"
                tools:ignore="MissingConstraints"/>
        <EditText
                android:id="@+id/etUserInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="入力欄" tools:layout_editor_absoluteY="440dp"
                tools:layout_editor_absoluteX="-4dp" tools:ignore="MissingConstraints"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>