<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 눌린 상태 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_pressed"/>
            <corners android:radius="16dp"/>
            <stroke android:width="2dp" android:color="@color/button_primary"/>
        </shape>
    </item>

    <!-- 비활성화 상태 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FFE0E0E0"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#FFCCCCCC"/>
        </shape>
    </item>

    <!-- 기본 상태 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_primary"/>
            <corners android:radius="16dp"/>
            <stroke android:width="2dp" android:color="@color/button_secondary"/>
        </shape>
    </item>
</selector>